；龜卜 蛇 · 貪食蛇
；方向鍵 / WASD 移動，q 退出
無 貞() {
    量 宽度 隹 十 益 六;
    量 高度 隹 十 益 二;
    量 蛇X[十 乘 十 乘 二];
    量 蛇Y[十 乘 十 乘 二];
    量 长度 隹 三;
    量 方向 隹 四;
    量 死亡 隹 0;
    量 赢 隹 0;
    量 种子 隹 七;
    量 食X 隹 五;
    量 食Y 隹 五;
    量 头X 隹 八;
    量 头Y 隹 六;
    量 次 隹 0;
    量 行 隹 0;
    量 列 隹 0;
    量 身 隹 0;
    量 画 隹 0;
    量 试 隹 0;
    量 碰 隹 0;
    量 键 隹 0;
    量 新X 隹 0;
    量 新Y 隹 0;
    量 吃 隹 0;

    蛇X[0] 隹 八;
    蛇Y[0] 隹 六;
    蛇X[1] 隹 七;
    蛇Y[1] 隹 六;
    蛇X[2] 隹 六;
    蛇Y[2] 隹 六;

    言 「方向鍵 分 WASD 移動，q 退出」;
    復 (死亡 隹 0) {
        屏();
        行 隹 0;
        復 (行 < 高度) {
            列 隹 0;
            復 (列 < 宽度) {
                画 隹 0;
                若 (列 隹 食X && 行 隹 食Y) { 画 隹 二; }
                身 隹 0;
                復 (身 < 长度) {
                    若 (蛇X[身] 隹 列 && 蛇Y[身] 隹 行) { 画 隹 一; }
                    身 隹 身 益 一;
                }
                若 (画 隹 一) { 书(「█」); }
                弗 {
                    若 (画 隹 二) { 书(「◆」); }
                    弗 { 书(「·」); }
                }
                列 隹 列 益 一;
            }
            书(十);
            行 隹 行 益 一;
        }
        书(「長：」);
        言 长度;

        键 隹 听();
        若 (键 隹 0) { 死亡 隹 一; }
        若 (键 隹 一 && 方向 不隹 二) { 方向 隹 一; }
        若 (键 隹 二 && 方向 不隹 一) { 方向 隹 二; }
        若 (键 隹 三 && 方向 不隹 四) { 方向 隹 三; }
        若 (键 隹 四 && 方向 不隹 三) { 方向 隹 四; }

        若 (死亡 隹 0 && 键 不隹 九) {
            新X 隹 头X;
            新Y 隹 头Y;
            若 (方向 隹 一) { 新Y 隹 头Y 去 一; }
            若 (方向 隹 二) { 新Y 隹 头Y 益 一; }
            若 (方向 隹 三) { 新X 隹 头X 去 一; }
            若 (方向 隹 四) { 新X 隹 头X 益 一; }

            若 (新X < 0 || 新X >= 宽度 || 新Y < 0 || 新Y >= 高度) { 死亡 隹 一; }

            若 (死亡 隹 0) {
                吃 隹 0;
                若 (新X 隹 食X && 新Y 隹 食Y) { 吃 隹 一; }
                次 隹 长度;
                復 (次 > 0) {
                    蛇X[次] 隹 蛇X[次 去 一];
                    蛇Y[次] 隹 蛇Y[次 去 一];
                    次 隹 次 去 一;
                }
                蛇X[0] 隹 新X;
                蛇Y[0] 隹 新Y;

                身 隹 一;
                復 (身 < 长度 益 吃) {
                    若 (蛇X[身] 隹 新X && 蛇Y[身] 隹 新Y) { 死亡 隹 一; }
                    身 隹 身 益 一;
                }

                若 (死亡 隹 0) {
                    若 (新X 隹 食X && 新Y 隹 食Y) {
                        若 (长度 < 十 乘 十 乘 二 去 五) { 长度 隹 长度 益 一; }
                        弗 { 赢 隹 一; 死亡 隹 一; }
                        试 隹 0;
                        復 (试 < 五 乘 十) {
                            种子 隹 种子 乘 七 益 三;
                            食X 隹 种子 % 宽度;
                            种子 隹 种子 乘 七 益 五;
                            食Y 隹 种子 % 高度;
                            碰 隹 0;
                            身 隹 0;
                            復 (身 < 长度) {
                                若 (蛇X[身] 隹 食X && 蛇Y[身] 隹 食Y) { 碰 隹 一; }
                                身 隹 身 益 一;
                            }
                            若 (碰 隹 0) { 试 隹 五 乘 十; }
                            弗 { 试 隹 试 益 一; }
                        }
                    }
                }
                头X 隹 新X;
                头Y 隹 新Y;
            }
        }
    }
    屏();
    若 (赢 隹 一) { 言 「贏」; }
    弗 { 言 「亡」; }
    言 长度;
    歸;
}
