；學 · 數學標準庫
量 大(量 甲, 量 乙) {
    若 (甲 > 乙) { 歸 甲; }
    歸 乙;
}
量 小(量 甲, 量 乙) {
    若 (甲 < 乙) { 歸 甲; }
    歸 乙;
}
量 方(量 甲) {
    歸 甲 乘 甲;
}
量 正(量 甲) {
    若 (甲 < 0) { 歸 0 去 甲; }
    歸 甲;
}
量 余(量 甲, 量 乙) {
    歸 甲 % 乙;
}
量 共(量 甲[], 量 乙) {
    量 丙 隹 0;
    量 丁 隹 0;
    復 (丁 < 乙) {
        丙 隹 丙 益 甲[丁];
        丁 隹 丁 益 一;
    }
    歸 丙;
}