；龜卜 龜食 · 甲骨貪食蛇
無 貞() {
    量 度 隹 十 益 六;
    量 高 隹 十 益 二;
    量 龜身[十 乘 十 乘 二];
    量 長 隹 三;
    量 向 隹 四;
    量 死 隹 0;
    量 食 隹 五;
    量 首 隹 八 乘 度 益 六;
    量 次 隹 0;
    量 目 隹 0;
    量 身 隹 0;
    量 畫 隹 0;
    量 新 隹 0;
    量 吃 隹 0;
    量 得 隹 0;
    龜身[0] 隹 首;
    龜身[1] 隹 首 去 一;
    龜身[2] 隹 首 去 二;
    言 「龜食」;
    復 (死 隹 0) {
        屏();
        目 隹 0;
        復 (目 < 高) {
            次 隹 0;
            復 (次 < 度) {
                畫 隹 0;
                若 (目 乘 度 益 次 隹 食) { 畫 隹 二; }
                身 隹 0;
                復 (身 < 長) {
                    若 (龜身[身] 隹 目 乘 度 益 次) { 畫 隹 一; }
                    身 隹 身 益 一;
                }
                若 (畫 隹 一) { 书(「█」); }
                弗 {
                    若 (畫 隹 二) { 书(「◆」); }
                    弗 { 书(「·」); }
                }
                次 隹 次 益 一;
            }
            书(十);
            目 隹 目 益 一;
        }
        得 隹 聽();
        若 (得 隹 0) { 死 隹 一; }
        若 (得 隹 一) { 若 (向 不隹 二) { 向 隹 一; } }
        若 (得 隹 二) { 若 (向 不隹 一) { 向 隹 二; } }
        若 (得 隹 三) { 若 (向 不隹 四) { 向 隹 三; } }
        若 (得 隹 四) { 若 (向 不隹 三) { 向 隹 四; } }
        若 (死 隹 0) {
            若 (得 不隹 九) {
                若 (向 隹 一) { 若 (首 分 度 隹 0) { 死 隹 一; } }
                若 (向 隹 二) { 若 (首 分 度 隹 十 益 一) { 死 隹 一; } }
                若 (向 隹 三) { 若 (首 % 度 隹 0) { 死 隹 一; } }
                若 (向 隹 四) { 若 (首 % 度 隹 度 去 一) { 死 隹 一; } }
                若 (死 隹 0) {
                    新 隹 首;
                    若 (向 隹 一) { 新 隹 首 去 度; }
                    若 (向 隹 二) { 新 隹 首 益 度; }
                    若 (向 隹 三) { 新 隹 首 去 一; }
                    若 (向 隹 四) { 新 隹 首 益 一; }
                    吃 隹 0;
                    若 (新 隹 食) { 吃 隹 一; }
                    次 隹 長;
                    復 (次 > 0) {
                        龜身[次] 隹 龜身[次 去 一];
                        次 隹 次 去 一;
                    }
                    龜身[0] 隹 新;
                    首 隹 新;
                    若 (吃 隹 一) {
                        若 (長 < 十 乘 十 乘 二 去 五) { 長 隹 長 益 一; }
                        弗 { 死 隹 一; }
                        食 隹 (食 益 七 乘 度 益 三) % (度 乘 高);
                    }
                }
            }
        }
    }
    屏();
    言 「亡」;
    歸;
}
